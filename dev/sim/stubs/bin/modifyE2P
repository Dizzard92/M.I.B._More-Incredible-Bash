#!/usr/bin/env python3
# modifyE2P r <hexaddr> <hexlen>   -> "0x%08x: xx xx .." lines, 16 bytes each
# modifyE2P w <hexaddr> <byte>...  -> writes bytes (journaled)
# The line format is inferred from the parser in config/BASICS and apps/eeprom2bin.
import sys
sys.path.insert(0, "/sim/stubs")
from journal import journal, PROFILE
path = PROFILE + "/eeprom.bin"
args = sys.argv[1:]
if len(args) >= 3 and args[0] == "r":
    addr, length = int(args[1], 16), int(args[2], 16)
    data = open(path, "rb").read()[addr:addr + length]
    for i in range(0, len(data), 16):
        print("0x%08x: %s" % (addr + i, " ".join("%02x" % b for b in data[i:i + 16])))
elif len(args) >= 3 and args[0] == "w":
    journal("modifyE2P", *args)
    addr = int(args[1], 16)
    values = bytes(int(v, 16) for v in args[2:])
    data = bytearray(open(path, "rb").read())
    data[addr:addr + len(values)] = values
    open(path, "wb").write(data)
else:
    journal("modifyE2P", *args)
    print("usage: modifyE2P r|w <addr> ...", file=sys.stderr)
    sys.exit(1)
